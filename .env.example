# OpenAgents environment.
#
# Copy to .env and fill in what you need:   cp .env.example .env
# .env is gitignored. Never commit real keys.
# Settings use the OPENAGENTS_ prefix. Names from before the 0.6.0 rename, such as
# OPENHOURS_DB_PATH, still work.
#
# Keep real fleet configuration private too: it can contain local paths, personal
# context and MCP environment values. Commit only sanitized example files.

# ---------------------------------------------------------------------------
# Model providers - you need at least one
# ---------------------------------------------------------------------------

# OpenRouter. Choose an eligible free model yourself; the sample model may be paid.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenCode Zen / Go. One key unlocks both providers.
# Only needed when executor is "opencode".
OPENCODE_API_KEY=

# Direct provider keys, used by the eval harness rather than the daemon.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Docker - only if the defaults are wrong for your machine
# ---------------------------------------------------------------------------

# Linux/macOS: leave both unset. `docker` on PATH is used directly.
# Windows: Docker Desktop's native CLI is the default. Only set this to opt into
# Docker through a specific user-managed WSL distro.
# OPENAGENTS_WSL_DISTRO=Ubuntu-22.04

# Override the executable entirely - podman, docker.exe, or an absolute path.
# Set on any platform; disables the WSL path and all path rewriting.
# OPENAGENTS_DOCKER_CMD=podman

# ---------------------------------------------------------------------------
# Runtime (all optional - openhours.config.json is the better place for these)
# ---------------------------------------------------------------------------

# builtin = this repo's own turn loop. opencode = the OpenCode CLI in a container.
# OPENAGENTS_EXECUTOR=builtin

# Standing goal the producer decomposes into tasks. Without it, and without a
# mission in the config file, the daemon only runs work you enqueue yourself.
# OPENAGENTS_MISSION=Build small, well-tested JavaScript utilities.

# Comma-separated benchmark names to run instead of a mission.
# OPENAGENTS_BACKLOG=cli-arg-parser,semver-range-resolver
# OPENAGENTS_BACKLOG_MODE=cycle

# Where the SQLite database lives.
# OPENAGENTS_DB_PATH=./data/openhours.db

# mock = never call a provider. Useful for development and CI.
# OPENAGENTS_LLM_MODE=mock
